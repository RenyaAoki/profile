# Copy these values into your shell or a local .env file (never commit real secrets).
PERSONAL_HUB_ADMIN_USERNAME=admin
PERSONAL_HUB_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Optional: set a stable secret key. If omitted, a random local key is saved in .data/.
# PERSONAL_HUB_SECRET_KEY=
# Set the canonical production URL when deployed, e.g. https://example.com
# PERSONAL_HUB_PUBLIC_URL=
# Set to true when HTTPS is enabled in production.
# PERSONAL_HUB_COOKIE_SECURE=true
